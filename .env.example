# Project Aghoy - Environment Variables (local dev)
# Copy to .env and .dev.vars, then fill in real values.
# NEVER commit .env or .dev.vars to version control.
# After adding keys here, run: wrangler secret put CEREBRAS_API_KEY (for Worker)

CEREBRAS_API_KEY=csk-your-key-here
GROQ_API_KEY=gsk_your-key-here
CF_ACCOUNT_ID=your-cloudflare-account-id
CF_GATEWAY_ID=your-gateway-id

# Guards write routes on the storage Worker (/indicators/verify, /seed/vectorize).
# Set via: wrangler secret put STORAGE_ADMIN_KEY
STORAGE_ADMIN_KEY=your-admin-key-here

# Signs expiring Dojo session tokens (HMAC-SHA256). Required for the Worker's
# /dojo/session, /dojo/start, and /dojo/chat routes; when unset those routes
# fail closed (503). Set via: wrangler secret put SESSION_SIGNING_KEY
SESSION_SIGNING_KEY=your-session-signing-key-here

# === KEY ROTATION ===
# If these keys were ever in plaintext on disk (they were - see .env / .dev.vars):
#   1. Go to Cerebras dashboard → generate a new key
#   2. Go to Groq dashboard → generate a new key
#   3. Update this file
#   4. Run: wrangler secret put CEREBRAS_API_KEY
#   5. Run: wrangler secret put GROQ_API_KEY
